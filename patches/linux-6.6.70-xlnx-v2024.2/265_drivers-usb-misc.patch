-};
-ATTRIBUTE_GROUPS(onboard_hub);
-
-static void onboard_hub_attach_usb_driver(struct work_struct *work)
-{
-	int err;
-
-	err = driver_attach(&onboard_hub_usbdev_driver.drvwrap.driver);
-	if (err)
-		pr_err("Failed to attach USB driver: %d\n", err);
